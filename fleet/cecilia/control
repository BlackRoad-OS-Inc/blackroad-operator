#!/bin/bash
if [ "$1" == "start" ]; then
    if pgrep -f "server.py" > /dev/null; then
        echo "Server Status: ✅ Already Running"
    else
        nohup python3 server.py > server.log 2>&1 &
        sleep 2
        if pgrep -f "server.py" > /dev/null; then
            echo "Server Status: ✅ Started Successfully"
        else
            echo "Server Status: ❌ Failed to Start"
            cat server.log
        fi
    fi
elif [ "$1" == "stop" ]; then
    pkill -f server.py
    echo "Server Status: ⚠️ Stopped"
fi
