[Unit]
Description=BlackRoad Chat API (FastAPI)
After=network.target ollama.service

[Service]
Type=simple
User=blackroad
WorkingDirectory=/opt/blackroad/chat-api
Environment=PYTHONUNBUFFERED=1
Environment=OLLAMA_URL=http://127.0.0.1:11434
ExecStart=/usr/bin/python3 -m uvicorn app:app --host 0.0.0.0 --port 8092
Restart=always
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
