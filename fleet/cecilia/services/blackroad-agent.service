[Unit]
Description=BlackRoad Agent Daemon
After=network.target

[Service]
Type=simple
User=blackroad
WorkingDirectory=/home/blackroad
ExecStart=/usr/bin/python3 /home/blackroad/blackroad-agent-daemon.py 4010
Restart=always
RestartSec=5
Environment=HOME=/home/blackroad

[Install]
WantedBy=multi-user.target
