[Unit]
Description=BlackRoad OS System Monitor
After=network.target

[Service]
Type=simple
User=cecilia
Environment=NODE_NAME=cecilia
Environment=MONITOR_PORT=9100
ExecStart=/usr/bin/python3 /home/cecilia/blackroad-os/services/system-monitor.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
