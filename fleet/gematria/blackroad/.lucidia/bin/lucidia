#!/bin/bash
# Lucidia - AI Communication Layer
# All agents speak through this interface
# BlackRoad OS, Inc.

set -euo pipefail

LUCIDIA_HOME="${LUCIDIA_HOME:-$HOME/.lucidia}"

case "${1:-}" in
    status)
        "$LUCIDIA_HOME/bin/lucidia-status"
        ;;
    sync)
        "$LUCIDIA_HOME/bin/lucidia-sync"
        ;;
    version)
        echo "Lucidia $LUCIDIA_VERSION"
        echo "BlackRoad OS, Inc."
        ;;
    help|--help|-h)
        echo "Lucidia - AI-Native Operating System"
        echo ""
        echo "Usage: lucidia [command]"
        echo ""
        echo "Commands:"
        echo "  status   Show system status"
        echo "  sync     Sync from upstream"
        echo "  version  Show version"
        echo "  help     Show this help"
        echo ""
        echo "Without arguments, enters AI query mode."
        ;;
    *)
        # Default: AI query mode
        echo "Lucidia AI | $(hostname)"
        if [ -n "${1:-}" ]; then
            echo "Query: $*"
            echo "(AI backends not yet configured)"
        fi
        ;;
esac
