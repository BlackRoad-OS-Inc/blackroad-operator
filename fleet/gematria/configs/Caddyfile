# --- CHAT (self-hosted on Gematria) ---
chat.blackroad.io {
	header Cache-Control "no-cache, no-store, must-revalidate"
	header Pragma "no-cache"
	root * /var/www/chat
	file_server

	handle /api/health {
		reverse_proxy 10.8.0.3:8092
		header Access-Control-Allow-Origin *
	}

	handle /api/chat {
	reverse_proxy 10.8.0.3:8092
	header Access-Control-Allow-Origin *
	header Access-Control-Allow-Methods "GET, POST, OPTIONS"
	header Access-Control-Allow-Headers "Content-Type"
}

	handle /api/generate {
	reverse_proxy 10.8.0.3:8092
	header Access-Control-Allow-Origin *
}

	handle /api/tags {
	reverse_proxy 10.8.0.3:8092
	header Access-Control-Allow-Origin *
}

	@cors method OPTIONS
	handle @cors {
		header Access-Control-Allow-Origin *
		header Access-Control-Allow-Methods "GET, POST, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type"
		respond 204
	}

	header X-Served-By "BlackRoad Edge → Gematria"
}

