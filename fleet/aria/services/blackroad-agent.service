[Unit]
Description=BlackRoad Pi Agent
After=network.target

[Service]
Type=simple
Environment="NODE_NAME=aria"
Environment="NODE_ROLE=agent-orchestration"
Environment="NODE_PORT=8180"
Environment="OPERATOR_URL=https://blackroad-operator.amundsonalexa.workers.dev"
ExecStart=/usr/bin/python3 /opt/blackroad/agent.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
