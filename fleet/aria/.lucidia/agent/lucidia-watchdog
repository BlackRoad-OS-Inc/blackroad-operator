#!/bin/bash
# Lucidia Watchdog - Monitors all agents across the fleet
# Runs on gematria (central monitoring)
# BlackRoad OS, Inc.

set -euo pipefail

LUCIDIA_HOME="${LUCIDIA_HOME:-$HOME/.lucidia}"
WATCHDOG_DIR="$LUCIDIA_HOME/watchdog"
LOG_FILE="$WATCHDOG_DIR/watchdog.log"
STATE_FILE="$WATCHDOG_DIR/fleet-state.json"
ALERT_THRESHOLD=300  # 5 minutes without heartbeat = alert

# Fleet hosts (using Tailscale IPs for cross-network access)
# Note: Tailscale names differ from actual hostnames - verified via SSH
FLEET_HOSTS=(
    "blackroad@100.72.180.98:cecilia"
    "blackroad@100.83.149.86:lucidia"
    "blackroad@100.109.14.17:aria"
    "blackroad@100.66.235.47:octavia"
    "blackroad@100.77.210.18:alice"
    "blackroad@174.138.44.45:anastasia"
)

mkdir -p "$WATCHDOG_DIR"

log() {
    echo "[$(date -Iseconds)] [$1] $2" | tee -a "$LOG_FILE"
}

# Check a single agent
check_agent() {
    local host_spec="$1"
    local ssh_target="${host_spec%:*}"
    local name="${host_spec#*:}"

    local state_file="/home/blackroad/.lucidia/agent/state.json"
    local result

    if result=$(ssh -o ConnectTimeout=5 -o BatchMode=yes "$ssh_target" "cat $state_file 2>/dev/null" 2>/dev/null); then
        local status last_heartbeat
        status=$(echo "$result" | grep -o '"status": *"[^"]*"' | cut -d'"' -f4)
        last_heartbeat=$(echo "$result" | grep -o '"last_heartbeat": *"[^"]*"' | cut -d'"' -f4)

        if [ "$status" = "running" ]; then
            echo "online|$last_heartbeat"
        else
            echo "stopped|$last_heartbeat"
        fi
    else
        echo "unreachable|never"
    fi
}

# Check all agents
check_fleet() {
    log "INFO" "Checking fleet status..."

    local fleet_json="{"
    local first=true
    local alerts=""

    for host_spec in "${FLEET_HOSTS[@]}"; do
        local name="${host_spec#*:}"
        local result
        result=$(check_agent "$host_spec")

        local status="${result%|*}"
        local heartbeat="${result#*|}"

        if [ "$first" = true ]; then
            first=false
        else
            fleet_json+=","
        fi

        fleet_json+="\"$name\":{\"status\":\"$status\",\"last_heartbeat\":\"$heartbeat\"}"

        # Check for alerts
        if [ "$status" = "unreachable" ]; then
            alerts+="ALERT: $name is unreachable\n"
            log "ALERT" "$name is UNREACHABLE"
        elif [ "$status" = "stopped" ]; then
            alerts+="WARN: $name agent is stopped\n"
            log "WARN" "$name agent is STOPPED"
        else
            log "INFO" "$name: OK"
        fi
    done

    fleet_json+="}"

    # Write state
    echo "$fleet_json" | python3 -m json.tool > "$STATE_FILE" 2>/dev/null || echo "$fleet_json" > "$STATE_FILE"

    # Log alerts to memory system if available
    if [ -n "$alerts" ] && command -v ~/memory-system.sh &>/dev/null; then
        ~/memory-system.sh log alert "watchdog" "$(echo -e "$alerts")" "watchdog,alert" 2>/dev/null || true
    fi
}

# Display fleet status
show_status() {
    echo "+----------------------------------------------+"
    echo "  LUCIDIA FLEET STATUS"
    echo "+----------------------------------------------+"

    for host_spec in "${FLEET_HOSTS[@]}"; do
        local name="${host_spec#*:}"
        local result
        result=$(check_agent "$host_spec")

        local status="${result%|*}"
        local heartbeat="${result#*|}"

        case "$status" in
            online)     printf "  %-12s  online   %s\n" "$name" "$heartbeat" ;;
            stopped)    printf "  %-12s  stopped  %s\n" "$name" "$heartbeat" ;;
            unreachable) printf "  %-12s  DOWN\n" "$name" ;;
        esac
    done

    echo "+----------------------------------------------+"
    echo "  BlackRoad OS, Inc."
    echo "+----------------------------------------------+"
}

# Main daemon loop
daemon() {
    log "INFO" "Starting Lucidia Watchdog"

    while true; do
        check_fleet
        sleep 60
    done
}

# Entry point
case "${1:-}" in
    start)
        daemon
        ;;
    status)
        show_status
        ;;
    check)
        check_fleet
        ;;
    *)
        echo "Lucidia Watchdog"
        echo "Usage: lucidia-watchdog {start|status|check}"
        ;;
esac
