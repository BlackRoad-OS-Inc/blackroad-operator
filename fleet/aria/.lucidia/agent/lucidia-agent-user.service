[Unit]
Description=Lucidia Agent - Autonomous AI Agent (User)
Documentation=https://github.com/BlackRoad-OS/lucidia-os
After=network.target

[Service]
Type=simple
Environment="LUCIDIA_HOME=%h/.lucidia"
Environment="PATH=%h/.lucidia/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.lucidia/agent/lucidia-agent start
ExecStop=%h/.lucidia/agent/lucidia-agent stop
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lucidia-agent

[Install]
WantedBy=default.target
