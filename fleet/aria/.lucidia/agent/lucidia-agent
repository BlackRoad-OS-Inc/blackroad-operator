#!/bin/bash
# Lucidia Agent Daemon
# Autonomous AI agent that runs forever
# BlackRoad OS, Inc.

set -euo pipefail

# Configuration
AGENT_NAME="${LUCIDIA_AGENT_NAME:-$(hostname)}"
AGENT_ID="${LUCIDIA_AGENT_ID:-$(hostname)-$$-$(date +%s)}"
HEARTBEAT_INTERVAL="${LUCIDIA_HEARTBEAT_INTERVAL:-60}"
TASK_POLL_INTERVAL="${LUCIDIA_TASK_POLL_INTERVAL:-30}"
LUCIDIA_HOME="${LUCIDIA_HOME:-$HOME/.lucidia}"
AGENT_DIR="$LUCIDIA_HOME/agent"
STATE_FILE="$AGENT_DIR/state.json"
LOG_FILE="$AGENT_DIR/agent.log"
PID_FILE="$AGENT_DIR/agent.pid"

# Ensure directories exist
mkdir -p "$AGENT_DIR"

# Logging
log() {
    local level="$1"
    shift
    echo "[$(date -Iseconds)] [$level] [$AGENT_NAME] $*" | tee -a "$LOG_FILE"
}

# Write state
write_state() {
    cat > "$STATE_FILE" << EOF
{
    "agent_id": "$AGENT_ID",
    "agent_name": "$AGENT_NAME",
    "hostname": "$(hostname)",
    "pid": $$,
    "status": "$1",
    "last_heartbeat": "$(date -Iseconds)",
    "uptime_seconds": $SECONDS,
    "task_count": ${TASK_COUNT:-0}
}
EOF
}

# Heartbeat - write to memory system if available
heartbeat() {
    write_state "running"

    # Try to log to memory system
    if command -v ~/memory-system.sh &>/dev/null; then
        ~/memory-system.sh log heartbeat "$AGENT_NAME" "alive pid=$$ uptime=${SECONDS}s tasks=${TASK_COUNT:-0}" "agent,heartbeat" 2>/dev/null || true
    fi

    log "INFO" "Heartbeat: uptime=${SECONDS}s tasks=${TASK_COUNT:-0}"
}

# Check for available AI backend
detect_backend() {
    if command -v ollama &>/dev/null && ollama list &>/dev/null 2>&1; then
        echo "ollama"
    elif [ -n "${ANTHROPIC_API_KEY:-}" ]; then
        echo "claude"
    elif [ -n "${OPENAI_API_KEY:-}" ]; then
        echo "openai"
    else
        echo "none"
    fi
}

# Execute a task using available backend
execute_task() {
    local task_id="$1"
    local task_desc="$2"
    local backend
    backend=$(detect_backend)

    log "INFO" "Executing task $task_id with backend: $backend"

    case "$backend" in
        ollama)
            # Use Ollama for task execution
            echo "$task_desc" | ollama run llama3.2 2>/dev/null || echo "Task processing attempted"
            ;;
        claude)
            # Would use Claude API here
            log "INFO" "Claude backend - task queued"
            ;;
        *)
            log "WARN" "No AI backend available, task queued"
            ;;
    esac

    TASK_COUNT=$((${TASK_COUNT:-0} + 1))
}

# Poll for tasks (simplified - checks task marketplace)
poll_tasks() {
    local task_dir="$HOME/.blackroad/memory/tasks/available"

    if [ -d "$task_dir" ]; then
        local task_file
        task_file=$(ls -1 "$task_dir"/*.json 2>/dev/null | head -1)

        if [ -n "$task_file" ] && [ -f "$task_file" ]; then
            local task_id
            task_id=$(basename "$task_file" .json)
            log "INFO" "Found task: $task_id"
            # Don't auto-execute yet - just log availability
            return 0
        fi
    fi
    return 1
}

# Signal handlers
cleanup() {
    log "INFO" "Shutting down agent..."
    write_state "stopped"
    rm -f "$PID_FILE"
    exit 0
}

trap cleanup SIGTERM SIGINT SIGHUP

# Main
main() {
    log "INFO" "Starting Lucidia Agent"
    log "INFO" "Agent ID: $AGENT_ID"
    log "INFO" "Backend: $(detect_backend)"

    # Write PID
    echo $$ > "$PID_FILE"

    # Initial state
    TASK_COUNT=0
    write_state "starting"

    local last_heartbeat=0
    local last_poll=0

    # Main loop
    while true; do
        local now
        now=$(date +%s)

        # Heartbeat
        if (( now - last_heartbeat >= HEARTBEAT_INTERVAL )); then
            heartbeat
            last_heartbeat=$now
        fi

        # Poll for tasks
        if (( now - last_poll >= TASK_POLL_INTERVAL )); then
            poll_tasks || true
            last_poll=$now
        fi

        # Sleep briefly
        sleep 5
    done
}

# Entry point
case "${1:-}" in
    start)
        main
        ;;
    status)
        if [ -f "$STATE_FILE" ]; then
            cat "$STATE_FILE"
        else
            echo "Agent not running"
            exit 1
        fi
        ;;
    stop)
        if [ -f "$PID_FILE" ]; then
            kill "$(cat "$PID_FILE")" 2>/dev/null || true
            rm -f "$PID_FILE"
            echo "Agent stopped"
        else
            echo "Agent not running"
        fi
        ;;
    logs)
        tail -f "$LOG_FILE"
        ;;
    *)
        echo "Lucidia Agent Daemon"
        echo "Usage: lucidia-agent {start|stop|status|logs}"
        echo ""
        echo "Environment variables:"
        echo "  LUCIDIA_AGENT_NAME     Agent name (default: hostname)"
        echo "  LUCIDIA_HEARTBEAT_INTERVAL  Heartbeat interval in seconds (default: 60)"
        echo "  LUCIDIA_TASK_POLL_INTERVAL  Task poll interval in seconds (default: 30)"
        ;;
esac
