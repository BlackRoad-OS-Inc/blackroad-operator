[Unit]
Description=Lucidia Agent - Autonomous AI Agent
Documentation=https://github.com/BlackRoad-OS/lucidia-os
After=network.target ollama.service
Wants=network.target

[Service]
Type=simple
User=blackroad
Group=blackroad
WorkingDirectory=/home/blackroad
Environment="LUCIDIA_HOME=/home/blackroad/.lucidia"
Environment="PATH=/home/blackroad/.lucidia/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/blackroad/.lucidia/agent/lucidia-agent start
ExecStop=/home/blackroad/.lucidia/agent/lucidia-agent stop
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lucidia-agent

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/blackroad/.lucidia

[Install]
WantedBy=multi-user.target
