    local nodes; nodes=$(_cv nodes_online)
    local containers; containers=$(_cv containers)
    local dbs; dbs=$(_cv databases)
    local collected; collected=$(_cv collected)

    cat <<JSON
{
  "name": "Alexa Amundson",
  "collected": "$collected",
  "infrastructure": {
    "local_repos": $repos,
    "scripts": $scripts,
    "fleet_nodes_online": $nodes,
