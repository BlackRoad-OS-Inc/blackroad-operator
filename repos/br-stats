            print_metric "📦" "Local Repositories" "$(_cv repos)" "$BR_BRAND" "$SHAPE_MEMORY"
            print_metric "⚡" "CLI Tools + Scripts" "$(_cv scripts)" "$BR_BRAND" "$SHAPE_EXEC"
            print_metric "🖥️" "Fleet Nodes Online" "$(_cv nodes_online)/$(_cv nodes_total)" "$BR_SUCCESS" "$SHAPE_MEMORY"
            print_metric "📦" "Docker Containers" "$(_cv containers)" "$BR_EXEC" "$SHAPE_MEMORY"
            print_metric "💾" "SQLite Databases" "$(_cv databases)" "$BR_MEMORY" "$SHAPE_MEMORY"
            print_metric "🌐" "Production Domains" "48+" "$BR_AGENT" "$SHAPE_MEMORY"
