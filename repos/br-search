# br-search - Quick wrapper for unified BlackRoad search

set -eo pipefail

SEARCH_SCRIPT="$HOME/blackroad-search-unified.py"

if [[ ! -f "$SEARCH_SCRIPT" ]]; then
  echo "Error: Search script not found at $SEARCH_SCRIPT" >&2
  exit 1
fi

if [[ -z "$1" ]]; then
  echo "Usage: br-search <query>" >&2
  exit 1
fi

exec python3 "$SEARCH_SCRIPT" "$@"
