# RoadCode edge routing (Gematria)
# Routes subdomains to Octavia containers via WireGuard

code.blackroad.io {
    reverse_proxy 10.10.2.3:3100
}

api.blackroad.io {
    handle /road/v1/* {
        reverse_proxy 10.10.2.3:3101
    }
    respond "Not Found" 404
}

search.blackroad.io {
    reverse_proxy 10.10.2.3:3102
}

audit.blackroad.io {
    reverse_proxy 10.10.2.3:3103
}

prism.blackroad.io {
    reverse_proxy 10.10.2.3:8787
}
