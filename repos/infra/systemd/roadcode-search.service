[Unit]
Description=RoadCode Search Service
After=network.target roadcode-registry.service

[Service]
Type=simple
User=blackroad
WorkingDirectory=/opt/roadcode-platform/services/search
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
Environment=PORT=3102
Environment=DB_PATH=/opt/roadcode-platform/data/search.db
Environment=REGISTRY_URL=http://localhost:3101

[Install]
WantedBy=multi-user.target
