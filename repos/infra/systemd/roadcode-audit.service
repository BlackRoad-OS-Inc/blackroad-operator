[Unit]
Description=RoadCode Audit Service
After=network.target

[Service]
Type=simple
User=blackroad
WorkingDirectory=/opt/roadcode-platform/services/audit
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
Environment=PORT=3103
Environment=DB_PATH=/opt/roadcode-platform/data/audit.db
Environment=CHAIN_PATH=/opt/roadcode-platform/data/chain.log

[Install]
WantedBy=multi-user.target
