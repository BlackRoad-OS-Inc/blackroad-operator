[Unit]
Description=RoadCode Registry Service
After=network.target

[Service]
Type=simple
User=blackroad
WorkingDirectory=/opt/roadcode-platform/services/registry
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
Environment=PORT=3101
Environment=DB_PATH=/opt/roadcode-platform/data/roadcode.db
Environment=REGISTRIES_PATH=/opt/roadcode-platform/registries

[Install]
WantedBy=multi-user.target
