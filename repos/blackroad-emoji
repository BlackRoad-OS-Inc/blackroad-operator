echo "🍓 NODES"
yq '.nodes | to_entries[] | .value.emoji + " " + .key + " " + .value.state' "$STATE"

echo ""
echo "☁️ CLOUD"
yq '.cloud | to_entries[] | .value.emoji + " " + .key + " " + .value.state' "$STATE"

