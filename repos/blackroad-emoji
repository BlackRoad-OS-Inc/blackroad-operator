STATE="$HOME/.blackroad/os/state.yaml"

echo ""
echo "🌍 BLACKROAD EMOJI OS"
echo "────────────────────"

echo "🧑‍💻 OPERATOR"
yq '.operator | .emoji + " " + .name + " " + .state + " " + .network' "$STATE"

