{
  "$schema": "../schemas/activity.schema.json",
  "id": "activity:template-project",
  "title": "[TEMPLATE] Project Activity",
  "description": "Template for creating project-based activities",
  "type": "project",
  "estimatedMinutes": 180,
  "rubricId": "rubric:project-analytic",
  "allowRetry": true,
  "passingScore": 70,
  "content": {
    "overview": "Build a real-world project that demonstrates mastery of concepts",
    "requirements": [
      "Requirement 1: [Description]",
      "Requirement 2: [Description]",
      "Requirement 3: [Description]"
    ],
    "deliverables": [
      "Working code/artifact",
      "Documentation",
      "Reflection on learning process"
    ],
    "steps": [
      {
        "phase": "Planning",
        "description": "Define your approach",
        "estimatedMinutes": 30
      },
      {
        "phase": "Implementation",
        "description": "Build your solution",
        "estimatedMinutes": 120
      },
      {
        "phase": "Testing & Refinement",
        "description": "Test and improve",
        "estimatedMinutes": 30
      }
    ],
    "submissionFormat": {
      "type": "repository",
      "instructions": "Submit a link to your repository with README"
    }
  }
