{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blackroad-os.dev/schemas/education/rubric.json",
  "title": "Rubric",
  "description": "Evaluation rubric for assessing learner work",
  "type": "object",
  "required": ["id", "title", "criteria"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "id": {
      "type": "string",
      "description": "Unique identifier for the rubric",
      "pattern": "^rubric:[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "description": "Rubric title",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Rubric purpose and usage"
    },
    "type": {
      "type": "string",
      "enum": ["holistic", "analytic", "checklist"],
      "description": "Type of rubric"
    },
    "criteria": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/criterion"
      },
      "minItems": 1,
      "description": "Evaluation criteria"
    },
    "descriptors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["level", "description"],
        "properties": {
          "level": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "description": "Level descriptors for holistic rubrics"
    },
    "agentAutomatable": {
      "type": "boolean",
      "default": false,
      "description": "Can agents auto-evaluate using this rubric?"
    },
    "requiresHumanReview": {
      "type": "boolean",
      "default": false,
      "description": "Requires human review before final grade"
    }
  },
  "definitions": {
    "criterion": {
      "type": "object",
      "required": ["id", "name", "levels"],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "description": "Weight in final score (optional)"
        },
        "levels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["level", "description", "points"],
            "properties": {
              "level": {
                "type": "string",
                "description": "Level name (e.g., 'Excellent', 'Good', 'Needs Work')"
              },
              "description": {
                "type": "string",
                "description": "What this level looks like"
              },
              "points": {
                "type": "number",
                "minimum": 0,
                "description": "Points awarded for this level"
              }
            }
          },
          "minItems": 2,
          "description": "Performance levels for this criterion"
        }
      }
    }
  },
  "additionalProperties": false
}
