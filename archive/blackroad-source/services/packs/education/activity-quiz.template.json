{
  "$schema": "../schemas/activity.schema.json",
  "id": "activity:template-quiz",
  "title": "[TEMPLATE] Quiz Activity",
  "description": "Template for creating quiz activities",
  "type": "quiz",
  "estimatedMinutes": 15,
  "rubricId": "rubric:standard-quiz",
  "allowRetry": true,
  "maxAttempts": 3,
  "passingScore": 70,
  "content": {
    "questions": [
      {
        "id": "q1",
        "type": "multiple-choice",
        "prompt": "Question text here?",
        "points": 10,
        "options": [
          {
            "id": "a",
            "text": "Option A",
            "correct": false
          },
          {
            "id": "b",
            "text": "Option B (correct)",
            "correct": true
          },
          {
            "id": "c",
            "text": "Option C",
            "correct": false
          }
        ],
        "hints": [
          "Think about...",
          "Consider the relationship between..."
        ]
      }
    ],
    "shuffleQuestions": false,
    "shuffleOptions": true
  }
}
