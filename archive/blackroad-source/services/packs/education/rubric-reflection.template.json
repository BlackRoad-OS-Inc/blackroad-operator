{
  "$schema": "../schemas/rubric.schema.json",
  "id": "rubric:reflection-checklist",
  "title": "Reflection Checklist",
  "description": "Simple checklist for evaluating reflection activities",
  "type": "checklist",
  "agentAutomatable": true,
  "requiresHumanReview": false,
  "criteria": [
    {
      "id": "addresses-prompts",
      "name": "Addresses All Prompts",
      "description": "Does the reflection respond to all provided prompts?",
      "weight": 30,
      "levels": [
        {
          "level": "Yes",
          "description": "All prompts addressed with thoughtful responses",
          "points": 100
        },
        {
          "level": "No",
          "description": "One or more prompts not addressed",
          "points": 0
        }
      ]
    },
    {
      "id": "sufficient-depth",
      "name": "Sufficient Depth",
      "description": "Goes beyond surface-level responses",
      "weight": 30,
      "levels": [
        {
          "level": "Yes",
          "description": "Thoughtful, specific, connects to learning",
          "points": 100
        },
        {
          "level": "No",
          "description": "Generic or minimal responses",
          "points": 0
        }
      ]
    },
    {
      "id": "makes-connections",
      "name": "Makes Connections",
      "description": "Connects learning to prior knowledge or real-world applications",
      "weight": 20,
      "levels": [
        {
          "level": "Yes",
          "description": "Clear connections made",
          "points": 100
        },
        {
          "level": "No",
          "description": "No connections made",
          "points": 0
        }
      ]
    },
    {
      "id": "meets-length",
      "name": "Meets Length Requirement",
      "description": "Meets minimum word count if specified",
      "weight": 20,
      "levels": [
        {
          "level": "Yes",
          "description": "Meets or exceeds minimum length",
          "points": 100
        },
        {
          "level": "No",
          "description": "Below minimum length",
          "points": 0
        }
      ]
    }
  ]
}
