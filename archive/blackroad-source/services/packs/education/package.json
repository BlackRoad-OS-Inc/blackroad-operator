{
  "name": "blackroad-os-pack-education",
  "version": "1.0.0",
  "description": "Education Pack for BlackRoad OS - learning flows, curricula, and teaching tools",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "node tests/run-all-tests.cjs",
    "test:schemas": "node tests/schema-validation.test.cjs",
    "test:states": "node tests/progress-states.test.cjs",
    "test:agents": "node tests/agent-config.test.cjs",
    "test:vitest": "vitest run",
    "lint:yaml": "node scripts/validate-yaml.mjs",
    "validate": "npm run test:schemas && npm run test:states && npm run test:agents"
  },
  "keywords": [
    "blackroad-os",
    "education",
    "learning",
    "courses",
    "teaching"
  ],
  "author": "BlackRoad OS",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.37",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "js-yaml": "^4.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "vitest": "^4.0.18"
  }
}
