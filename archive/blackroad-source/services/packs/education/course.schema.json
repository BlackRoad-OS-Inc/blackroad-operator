{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blackroad-os.dev/schemas/education/course.json",
  "title": "Course",
  "description": "A complete course structure with modules, lessons, and assessments",
  "type": "object",
  "required": ["id", "title", "version", "prerequisites", "outcomes", "modules"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "id": {
      "type": "string",
      "description": "Unique identifier for the course",
      "pattern": "^course:[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "description": "Human-readable course title",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Course overview and summary"
    },
    "version": {
      "type": "string",
      "description": "Course version (semver)",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "level": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced", "expert"],
      "description": "Target skill level"
    },
    "estimatedHours": {
      "type": "number",
      "minimum": 0,
      "description": "Estimated completion time in hours"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for categorization and search"
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "reference"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["course", "skill", "knowledge"]
          },
          "reference": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "description": "Requirements before starting this course"
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Learning outcomes - what learners will be able to do"
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/module"
      },
      "minItems": 1,
      "description": "Course modules in sequential order"
    },
    "suggested_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "weight"],
        "properties": {
          "type": { "type": "string" },
          "weight": { "type": "number" }
        }
      },
      "description": "Suggested assessments for the course"
    },
    "target_learners": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Target audience for this course"
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" }
        }
      },
      "description": "Learning objectives"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "author": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "complianceCategory": {
          "type": "string",
          "description": "REQUIRED TRAINING FLOW - COMPLETION MUST BE AUDITABLE"
        }
      }
    }
  },
  "definitions": {
    "module": {
      "type": "object",
      "required": ["id", "title", "lessons"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^module:[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "lessons": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Reference to lesson ID"
          },
          "minItems": 1
        },
        "objectives": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Module-specific objectives"
        },
        "assessment": {
          "type": "string",
          "description": "Reference to module assessment ID"
        }
      }
    }
  },
  "additionalProperties": false
}
