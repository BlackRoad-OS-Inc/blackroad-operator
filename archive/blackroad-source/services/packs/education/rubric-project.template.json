{
  "$schema": "../schemas/rubric.schema.json",
  "id": "rubric:project-analytic",
  "title": "Project Analytic Rubric",
  "description": "Comprehensive rubric for evaluating project work",
  "type": "analytic",
  "agentAutomatable": true,
  "requiresHumanReview": true,
  "criteria": [
    {
      "id": "correctness",
      "name": "Correctness & Functionality",
      "description": "Does the project work as intended and meet requirements?",
      "weight": 40,
      "levels": [
        {
          "level": "Excellent",
          "description": "Fully functional, exceeds requirements, handles edge cases",
          "points": 100
        },
        {
          "level": "Good",
          "description": "Meets all requirements, works correctly for typical cases",
          "points": 85
        },
        {
          "level": "Satisfactory",
          "description": "Meets most requirements, minor bugs present",
          "points": 70
        },
        {
          "level": "Needs Work",
          "description": "Incomplete or significant bugs",
          "points": 50
        }
      ]
    },
    {
      "id": "code-quality",
      "name": "Code Quality & Organization",
      "description": "Is the code well-structured, readable, and maintainable?",
      "weight": 30,
      "levels": [
        {
          "level": "Excellent",
          "description": "Clean, well-organized, follows best practices",
          "points": 100
        },
        {
          "level": "Good",
          "description": "Generally well-organized with minor issues",
          "points": 85
        },
        {
          "level": "Satisfactory",
          "description": "Functional but could be better organized",
          "points": 70
        },
        {
          "level": "Needs Work",
          "description": "Poorly organized or hard to understand",
          "points": 50
        }
      ]
    },
    {
      "id": "documentation",
      "name": "Documentation",
      "description": "Is the project well-documented?",
      "weight": 20,
      "levels": [
        {
          "level": "Excellent",
          "description": "Comprehensive documentation, clear README, inline comments",
          "points": 100
        },
        {
          "level": "Good",
          "description": "Good documentation covering key aspects",
          "points": 85
        },
        {
          "level": "Satisfactory",
          "description": "Basic documentation present",
          "points": 70
        },
        {
          "level": "Needs Work",
          "description": "Minimal or missing documentation",
          "points": 50
        }
      ]
    },
    {
      "id": "learning-demonstration",
      "name": "Learning Demonstration",
      "description": "Does the project demonstrate understanding of concepts?",
      "weight": 10,
      "levels": [
        {
          "level": "Excellent",
          "description": "Clear mastery and creative application",
          "points": 100
        },
        {
          "level": "Good",
          "description": "Good understanding demonstrated",
          "points": 85
        },
        {
          "level": "Satisfactory",
          "description": "Basic understanding shown",
          "points": 70
        },
        {
          "level": "Needs Work",
          "description": "Limited understanding evident",
          "points": 50
        }
      ]
    }
  ]
}
