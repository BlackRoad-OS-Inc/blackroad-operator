{
  "$schema": "../schemas/rubric.schema.json",
  "id": "rubric:standard-quiz",
  "title": "Standard Quiz Rubric",
  "description": "Simple rubric for quiz grading based on correctness",
  "type": "holistic",
  "agentAutomatable": true,
  "requiresHumanReview": false,
  "criteria": [
    {
      "id": "correctness",
      "name": "Answer Correctness",
      "description": "Percentage of questions answered correctly",
      "weight": 100,
      "levels": [
        {
          "level": "Excellent",
          "description": "90-100% correct",
          "points": 100
        },
        {
          "level": "Good",
          "description": "80-89% correct",
          "points": 85
        },
        {
          "level": "Satisfactory",
          "description": "70-79% correct",
          "points": 75
        },
        {
          "level": "Needs Improvement",
          "description": "Below 70% correct",
          "points": 50
        }
      ]
    }
  ]
}
