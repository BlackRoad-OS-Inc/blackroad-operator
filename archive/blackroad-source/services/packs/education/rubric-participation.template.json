{
  "$schema": "../schemas/rubric.schema.json",
  "id": "rubric:participation-checklist",
  "title": "Participation Checklist",
  "description": "Simple checklist for evaluating participation in discussions or activities",
  "type": "checklist",
  "agentAutomatable": false,
  "requiresHumanReview": true,
  "criteria": [
    {
      "id": "engaged",
      "name": "Actively Engaged",
      "description": "Participated meaningfully in the activity",
      "weight": 40,
      "levels": [
        {
          "level": "Yes",
          "description": "Active, thoughtful participation",
          "points": 100
        },
        {
          "level": "No",
          "description": "Minimal or no participation",
          "points": 0
        }
      ]
    },
    {
      "id": "contributed",
      "name": "Contributed Ideas",
      "description": "Shared ideas, questions, or insights",
      "weight": 30,
      "levels": [
        {
          "level": "Yes",
          "description": "Made meaningful contributions",
          "points": 100
        },
        {
          "level": "No",
          "description": "Did not contribute",
          "points": 0
        }
      ]
    },
    {
      "id": "respectful",
      "name": "Respectful Communication",
      "description": "Communicated respectfully with others",
      "weight": 20,
      "levels": [
        {
          "level": "Yes",
          "description": "Respectful and constructive",
          "points": 100
        },
        {
          "level": "No",
          "description": "Disrespectful or unconstructive",
          "points": 0
        }
      ]
    },
    {
      "id": "prepared",
      "name": "Came Prepared",
      "description": "Completed required preparation before participation",
      "weight": 10,
      "levels": [
        {
          "level": "Yes",
          "description": "Well-prepared",
          "points": 100
        },
        {
          "level": "No",
          "description": "Not prepared",
          "points": 0
        }
      ]
    }
  ]
}
