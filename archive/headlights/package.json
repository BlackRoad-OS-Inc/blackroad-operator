{
  "name": "headlights-blackroad",
  "version": "0.1.0",
  "description": "Headlights by BlackRoad OS, Inc. — Sovereign VR",
  "private": true,
  "author": "BlackRoad OS, Inc.",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "npx serve src -l 8100 --no-clipboard",
    "build": "mkdir -p dist && cp -r src/* dist/",
    "deploy": "wrangler deploy",
    "sideload": "bash bin/headlights.sh install dist/headlights.apk",
    "status": "bash bin/headlights.sh status",
    "mirror": "bash bin/headlights.sh mirror",
    "screenshot": "bash bin/headlights.sh screenshot",
    "stream": "bash bin/headlights.sh stream",
    "info": "bash bin/headlights.sh info"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
