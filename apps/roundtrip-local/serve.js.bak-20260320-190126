#!/usr/bin/env node
// RoundTrip v5 — Self-hosted agent hub with Memory, Code, and Dispatch
const http = require('http');
const path = require('path');
const fs = require('fs');
const { execSync } = require('child_process');

// ── SQLite ──
let Database;
try { Database = require('better-sqlite3'); } catch {
  execSync('npm install better-sqlite3', { cwd: __dirname, stdio: 'inherit' });
  Database = require('better-sqlite3');
}
const db = new Database(path.join(__dirname, 'roundtrip.db'));
db.pragma('journal_mode = WAL');

db.exec(`
  CREATE TABLE IF NOT EXISTS memory (id INTEGER PRIMARY KEY AUTOINCREMENT, agent_id TEXT, category TEXT, key TEXT, value TEXT, created_at DATETIME DEFAULT (?));
  CREATE TABLE IF NOT EXISTS dispatch (id TEXT PRIMARY KEY, agent_id TEXT, command TEXT, args TEXT, status TEXT DEFAULT 'pending', result TEXT, created_at DATETIME DEFAULT (?), completed_at DATETIME);
  CREATE TABLE IF NOT EXISTS messages (id INTEGER PRIMARY KEY AUTOINCREMENT, channel TEXT DEFAULT 'general', agent_id TEXT, name TEXT, emoji TEXT, color TEXT, text TEXT, time DATETIME DEFAULT (?));
`);

// ── D1/KV wrappers for CF Worker compat ──
const D1 = { prepare(sql) { return { bind(...a) { return { async run(){try{return db.prepare(sql).run(...a)}catch(e){return{error:e.message}}}, async all(){try{return{results:db.prepare(sql).all(...a)}}catch(e){return{results:[]}}}, async first(){try{return db.prepare(sql).get(...a)}catch(e){return null}} }; }, async run(){try{return db.prepare(sql).run()}catch(e){return{error:e.message}}}, async all(){try{return{results:db.prepare(sql).all()}}catch(e){return{results:[]}}} }; } };
const kvStore = new Map();
const KV = { async get(k){return kvStore.get(k)||null}, async put(k,v){kvStore.set(k,v)}, async delete(k){kvStore.delete(k)} };
const env = { DB: D1, ROUNDTRIP_KV: KV, MESH_SECRET: 'blackroad-mesh-2026' };

// ── Load CF Worker ──
let ws = fs.readFileSync(path.join(__dirname, 'src/worker.js'), 'utf-8');
ws = ws.replace(/^import .* from .*$/gm, '// [removed]');
ws = ws.replace('export default {', 'module.exports = {');
const pp = path.join(__dirname, 'src/_worker_patched.js');
fs.writeFileSync(pp, ws);
if (!globalThis.crypto?.randomUUID) globalThis.crypto = { randomUUID: require('crypto').randomUUID };
const worker = require(pp);

// ── Parse agent personas ──
const AGENTS = {};
try {
  const m = ws.match(/const AGENTS = \{([\s\S]*?)\n\};/);
  if (m) { eval('var _A = {' + m[1] + '}'); Object.assign(AGENTS, _A); }
} catch(e) { console.error('Agent parse:', e.message); }
console.log(`Loaded ${Object.keys(AGENTS).length} agents`);

// ── Ollama ──



// ── Adaptive Ollama Chat ──
async function ollamaChat(agentId, message, extraContext) {
  const agent = AGENTS[agentId] || {};
  const model = "blackroad-" + agentId;
  let adaptive = [];
  const msg = message.toLowerCase();
  if (/status|fleet|node|online|offline|pi|device|health/.test(msg))
    adaptive.push("Fleet: 5 Pis + 2 DO droplets, all online.");
  if (/repo|code|git|deploy|build|ship|worker/.test(msg)) {
    try {
      const r = await fetch("http://localhost:3100/api/v1/repos/search?limit=3&q=" + encodeURIComponent(message), {signal: AbortSignal.timeout(3000)});
      const d = await r.json();
      if (d.data && d.data.length) adaptive.push("Repos: " + d.data.map(r => r.full_name).join(", "));
    } catch {}
  }
  if (/threat|security|ssh|port|firewall|hack/.test(msg))
    adaptive.push("Security: fail2ban active, Tor on 3 Pis, WireGuard 12/12.");
  if (/domain|website|site|url|dns/.test(msg))
    adaptive.push("Sites: 19 root domains + 97 subdomains. Caddy on Gematria.");
  if (extraContext) adaptive.push(extraContext);
  adaptive.push("Time: " + new Date().toISOString().slice(0, 16));
  const messages = [];
  if (adaptive.length) messages.push({role: "system", content: adaptive.join(" | ")});
  messages.push({role: "user", content: message});
  const r = await fetch("http://localhost:11434/api/chat", {
    method: "POST", headers: {"Content-Type": "application/json"},
    body: JSON.stringify({model, stream: false, messages, options: {num_ctx: 512, num_predict: 30}}),
    signal: AbortSignal.timeout(90000)
  });
  return ((await r.json()).message?.content || "").trim();
}

// ── Shell ──
function safeExec(cmd, timeout = 10000) {
  if (/rm\s+-rf|mkfs|dd\s+if|shutdown|reboot|passwd|chmod\s+777/i.test(cmd)) return {error:'blocked'};
  try { return {output: execSync(cmd, {timeout, maxBuffer:512*1024, encoding:'utf-8', env:{...process.env, PATH:'/usr/local/bin:/usr/bin:/bin'}}).slice(0,4096)}; }
  catch(e) { return {error:e.message.slice(0,500), output:(e.stdout||'').slice(0,2048)}; }
}

// ── Code search ──
async function codeSearch(q, limit=10) {
  try { const r = await fetch(`http://localhost:3100/api/v1/repos/search?q=${encodeURIComponent(q)}&limit=${limit}`, {signal:AbortSignal.timeout(5000)}); const d = await r.json(); return (d.data||[]).map(r=>({name:r.full_name, desc:(r.description||'').slice(0,80), url:r.html_url})); }
  catch(e) { return [{error:e.message}]; }
}

// ── Memory ──
const Mem = {
  get: (a,k) => db.prepare('SELECT value FROM memory WHERE agent_id=? AND key=? ORDER BY created_at DESC LIMIT 1').get(a,k),
  set: (a,c,k,v) => db.prepare('INSERT INTO memory (agent_id,category,key,value) VALUES (?,?,?,?)').run(a,c,k,v),
  list: (a) => db.prepare('SELECT key,category,value,created_at FROM memory WHERE agent_id=? ORDER BY created_at DESC LIMIT 50').all(a),
  search: (q) => db.prepare('SELECT agent_id,key,value FROM memory WHERE value LIKE ? OR key LIKE ? LIMIT 20').all('%'+q+'%','%'+q+'%'),
  count: () => db.prepare('SELECT COUNT(*) as c FROM memory').get().c,
};

// ── Helpers ──
function json(res, data, status=200) {
  res.writeHead(status, {'Content-Type':'application/json','Access-Control-Allow-Origin':'*','Access-Control-Allow-Methods':'GET,POST,OPTIONS','Access-Control-Allow-Headers':'Content-Type'});
  res.end(JSON.stringify(data));
}

const PORT = process.env.PORT || 8094;
const server = http.createServer(async (req, res) => {
  const url = new URL(req.url, `http://localhost:${PORT}`);
  const p = url.pathname;

  if (req.method === 'OPTIONS') { json(res, {}, 204); return; }

  let body = null;
  if (req.method === 'POST' || req.method === 'PUT') {
    body = await new Promise(r => { const c=[]; req.on('data',d=>c.push(d)); req.on('end',()=>r(Buffer.concat(c).toString())); });
  }

  try {
    // ── CHAT ──
    if (p === '/api/chat' && req.method === 'POST') {
      const d = JSON.parse(body||'{}');
      const aid = d.agent||'alice', msg = d.message||'hello';
      const mems = Mem.list(aid).slice(0,3);
      const ctx = mems.length ? mems.map(m=>m.key+': '+m.value).join('\n') : '';
      const reply = await ollamaChat(aid, msg, ctx);
      const a = AGENTS[aid]||{};
      db.prepare('INSERT INTO messages (channel,agent_id,name,emoji,color,text) VALUES (?,?,?,?,?,?)').run('general',aid,a.name||aid,a.emoji||'',a.color||'#fff',reply);
      if (msg.length > 20) Mem.set(aid,'conversation','last-topic',msg.slice(0,200));
      return json(res, {agent:aid, name:a.name||aid, emoji:a.emoji, reply});
    }

    // ── MEMORY ──
    if (p === '/api/memory' && req.method === 'GET') {
      const a = url.searchParams.get('agent'), q = url.searchParams.get('q');
      if (q) return json(res, Mem.search(q));
      if (a) return json(res, Mem.list(a));
      return json(res, {total:Mem.count(), agents:db.prepare('SELECT DISTINCT agent_id FROM memory').all()});
    }
    if (p === '/api/memory' && req.method === 'POST') {
      const d = JSON.parse(body||'{}');
      Mem.set(d.agent||'system', d.category||'general', d.key, d.value);
      return json(res, {saved:true, key:d.key});
    }

    // ── CODE ──
    if (p === '/api/code/search') return json(res, await codeSearch(url.searchParams.get('q')||''));
    if (p === '/api/code/file' && req.method === 'POST') {
      const d = JSON.parse(body||'{}'), fp = d.path||'';
      if (!['/home/pi/roundtrip','/opt/blackroad','/home/pi'].some(s=>fp.startsWith(s))) return json(res,{error:'path not allowed'},403);
      try { return json(res, {content:fs.readFileSync(fp,'utf-8').slice(0,8192)}); } catch(e) { return json(res,{error:e.message},404); }
    }

    // ── DISPATCH (sync execution) ──
    if (p === '/api/dispatch' && req.method === 'POST') {
      const d = JSON.parse(body||'{}');
      const id = require('crypto').randomUUID().slice(0,8);
      const cmd = d.command, args = d.args||{};
      let result, status = 'done';
      try {
        if (cmd === 'shell') result = safeExec(args.cmd || (typeof args === 'string' ? args : ''));
        else if (cmd === 'search') result = await codeSearch(args.query || (typeof args === 'string' ? args : ''));
        else if (cmd === 'memory-read') result = Mem.get(args.agent||d.agent||'system', args.key);
        else if (cmd === 'memory-write') { Mem.set(d.agent||'system', args.category||'general', args.key, args.value); result = {saved:true}; }
        else if (cmd === 'fetch') { const r = await fetch(args.url, {signal:AbortSignal.timeout(10000)}); result = {status:r.status, body:(await r.text()).slice(0,4096)}; }
        else if (cmd === 'chat') { result = {reply: await ollamaChat(args.agent||d.agent||'alice', args.message||'')}; }
        else result = {error:'unknown: '+cmd};
      } catch(e) { result = {error:e.message}; status = 'error'; }
      db.prepare("INSERT INTO dispatch (id,agent_id,command,args,status,result,completed_at) VALUES (?,?,?,?,?,?,?)").run(id,d.agent||"system",cmd,JSON.stringify(args),status,JSON.stringify(result),new Date().toISOString());
      return json(res, {ticket:id, status, result});
    }
    if (p.startsWith('/api/dispatch/') && req.method === 'GET') {
      const t = db.prepare('SELECT * FROM dispatch WHERE id=?').get(p.split('/').pop());
      return t ? json(res, {...t, result:t.result?JSON.parse(t.result):null}) : json(res,{error:'not found'},404);
    }
    if (p === '/api/dispatch' && req.method === 'GET') return json(res, db.prepare('SELECT id,agent_id,command,status,created_at FROM dispatch ORDER BY created_at DESC LIMIT 20').all());

    // ── SHELL ──
    if (p === '/api/shell' && req.method === 'POST') return json(res, safeExec(JSON.parse(body||'{}').cmd||''));

    // ── FLEET ──
    if (p === '/api/fleet/live') {
      const nodes = [{id:'alice',check:'http://192.168.4.49:80'},{id:'octavia',check:'http://localhost:11434/api/tags'},{id:'lucidia',check:'http://192.168.4.38:80'},{id:'gematria',check:'http://10.8.0.8:11434/api/tags'},{id:'anastasia',check:'http://10.8.0.1:80/health'}];
      const r = await Promise.all(nodes.map(async n => { try { const t=Date.now(); await fetch(n.check,{signal:AbortSignal.timeout(3000)}); return {...n,status:'online',latency:Date.now()-t}; } catch { return {...n,status:'offline',latency:null}; } }));
      return json(res, r);
    }

    // ── SYSTEM ──
    if (p === '/api/system') return json(res, {version:'RoundTrip v5',node:process.version,uptime:process.uptime(),agents:Object.keys(AGENTS).length,messages:db.prepare('SELECT COUNT(*) as c FROM messages').get().c,memories:Mem.count(),dispatches:db.prepare('SELECT COUNT(*) as c FROM dispatch').get().c,model:'tinyllama'});

    // ── PASS TO CF WORKER ──
    const fetchReq = new Request(url.toString(), {method:req.method, headers:new Headers(req.headers), body});
    const response = await worker.fetch(fetchReq, env);
    const h = Object.fromEntries(response.headers.entries()); h['Access-Control-Allow-Origin']='*';
    res.writeHead(response.status, h);
    res.end(await response.text());
  } catch(e) { json(res, {error:e.message}, 500); }
});

server.listen(PORT, '0.0.0.0', () => console.log(`RoundTrip v5 on :${PORT} — ${Object.keys(AGENTS).length} agents`));
