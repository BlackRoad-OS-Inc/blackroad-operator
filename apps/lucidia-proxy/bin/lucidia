#!/bin/bash
# Lucidia — Claude Code-style AI CLI
# BlackRoad OS, Inc.
set -uo pipefail

OLLAMA="${OLLAMA_HOST:-http://localhost:11434}"
MODEL="${LUCIDIA_MODEL:-llama3.2:1b}"
CTX="[]"
SYS="${LUCIDIA_SYSTEM:-You are Lucidia, a brilliant AI assistant created by BlackRoad OS. You are running locally on a Raspberry Pi. Be concise, direct, and helpful. Use markdown formatting when useful.}"

# Colors
p='\033[38;5;205m'  # pink
v='\033[38;5;135m'  # violet
g='\033[38;5;82m'   # green
d='\033[38;5;245m'  # dim
w='\033[1;37m'      # white bold
r='\033[0m'         # reset
cy='\033[38;5;51m'  # cyan

_banner() {
    printf "\n"
    printf "${cy}  ✻${r} ${w}Lucidia${r} ${d}on${r} ${g}%s${r}\n" "$(hostname)"
    printf "${d}  model: %s${r}\n\n" "$MODEL"
}

_help() {
    printf "\n${w}Lucidia${r} ${d}v2.1${r}\n\n"
    printf "  ${g}lucidia${r}              Start chat\n"
    printf "  ${g}lucidia ask \"...\"${r}    One-shot question\n"
    printf "  ${g}lucidia models${r}       List models\n"
    printf "  ${g}lucidia status${r}       Check system\n\n"
    printf "  ${d}In chat:${r}\n"
    printf "  ${g}/model <n>${r}  ${g}/models${r}  ${g}/clear${r}  ${g}/help${r}  ${g}/exit${r}\n\n"
}

_models() {
    printf "\n${w}Models:${r}\n"
    curl -sf "$OLLAMA/api/tags" | jq -r '.models[] | "  \(.name)\t\(.details.parameter_size // "?")"' 2>/dev/null
    printf "\n"
}

_status() {
    printf "${w}Lucidia${r} ${g}$(hostname)${r}\n"
    local n
    n=$(curl -sf "$OLLAMA/api/tags" | jq '.models | length' 2>/dev/null || echo "?")
    printf "${d}ollama${r}  ${g}running${r}  ${d}models${r} ${g}%s${r}  ${d}active${r} ${g}%s${r}\n" "$n" "$MODEL"
}

# Stream from Ollama — jq unbuffered, no python
_stream() {
    local model="$1" prompt="$2" ctx="$3"
    local payload
    payload=$(jq -nc --arg m "$model" --arg p "$prompt" --arg s "$SYS" --argjson c "$ctx" \
        '{model:$m, prompt:$p, system:$s, context:$c, stream:true}')

    printf "${v}"
    curl -sfN "$OLLAMA/api/generate" \
        -H "Content-Type: application/json" \
        -d "$payload" 2>/dev/null | while IFS= read -r line; do
        printf '%s' "$(echo "$line" | jq -rj '.response // empty' 2>/dev/null)"
        if [ "$(echo "$line" | jq -r '.done // false' 2>/dev/null)" = "true" ]; then
            echo "$line" | jq -c '.context // []' > /tmp/.lctx 2>/dev/null
        fi
    done
    printf "${r}\n\n"
}

_oneshot() {
    printf "${d}>${r} ${w}%s${r}\n\n" "$*"
    _stream "$MODEL" "$*" "[]"
}

_chat() {
    _banner
    local ctx="[]" model="$MODEL" input
    while true; do
        printf "${p}>${r} "
        IFS= read -r input || break
        [ -z "$input" ] && continue
        case "$input" in
            /exit|/quit|/q) break ;;
            /clear) ctx="[]"; printf "\033[2J\033[H"; _banner; continue ;;
            /models) _models; continue ;;
            /model\ *) model="${input#/model }"; ctx="[]"; printf "${g}→ %s${r}\n" "$model"; continue ;;
            /model) printf "${d}%s${r}\n" "$model"; continue ;;
            /help|/h) _help; continue ;;
            /*) printf "${d}? try /help${r}\n"; continue ;;
        esac
        _stream "$model" "$input" "$ctx"
        [ -f /tmp/.lctx ] && { ctx=$(cat /tmp/.lctx); rm -f /tmp/.lctx; }
    done
}

case "${1:-}" in
    ask|a) shift; _oneshot "$@" ;;
    chat|c) _chat ;;
    models|m) _models ;;
    status|s) _status ;;
    help|--help|-h) _help ;;
    version|v) echo "Lucidia 2.1.0" ;;
    "") _chat ;;
    *) _oneshot "$@" ;;
esac
