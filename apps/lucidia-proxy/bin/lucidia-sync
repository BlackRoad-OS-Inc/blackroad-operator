#!/bin/bash
# Lucidia Sync - Update from upstream
# BlackRoad OS, Inc.

set -euo pipefail

LUCIDIA_HOME="${LUCIDIA_HOME:-$HOME/.lucidia}"

echo "Lucidia Sync"
echo "============"
echo ""

if [ -d "$LUCIDIA_HOME/.git" ]; then
    echo "Pulling from GitHub..."
    cd "$LUCIDIA_HOME"
    git pull --rebase
    echo ""
    echo "Sync complete."
else
    echo "Not a git repository. Manual sync required."
    echo "Or reinstall: curl -sL https://raw.githubusercontent.com/BlackRoad-OS/lucidia-os/main/install.sh | bash"
fi
