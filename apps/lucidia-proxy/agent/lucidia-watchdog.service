[Unit]
Description=Lucidia Watchdog - Fleet Monitoring
Documentation=https://github.com/BlackRoad-OS/lucidia-os
After=network.target

[Service]
Type=simple
User=blackroad
Group=blackroad
WorkingDirectory=/home/blackroad
Environment="LUCIDIA_HOME=/home/blackroad/.lucidia"
ExecStart=/home/blackroad/.lucidia/agent/lucidia-watchdog start
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lucidia-watchdog

[Install]
WantedBy=multi-user.target
