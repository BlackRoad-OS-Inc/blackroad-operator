#!/bin/bash
# br-header — shared branded header for all BR terminal apps
# Usage: source br-header; br_head "APP NAME" "subtitle"

W='\033[1;37m'
D='\033[0;90m'
N='\033[0m'

br_head() {
    local name="$1" sub="${2:-}"
    printf "\n  ${W}BLACKROAD OS${N}  ${D}%s${N}\n" "$name"
    printf "  ${D}────────────────────────────────────────────────${N}\n"
    [[ -n "$sub" ]] && printf "  ${D}%s${N}\n" "$sub"
    echo ""
}

br_line() {
    printf "  ${D}────────────────────────────────────────────────${N}\n"
}

br_done() {
    echo ""
    printf "  ${D}────────────────────────────────────────────────${N}\n"
    printf "  ${D}Pave Tomorrow.${N}\n\n"
}
