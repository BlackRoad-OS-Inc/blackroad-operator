#!/bin/bash
HOST="$1"
[[ -z "$HOST" ]] && { echo "Usage: br-ssh <host>"; exit 1; }
W='\033[1;37m'
D='\033[0;90m'
N='\033[0m'
printf "\n  ${W}BLACKROAD OS${N}  ${D}ssh${N}\n"
printf "  ${D}────────────────────────${N}\n"
printf "  ${W}%s${N}\n\n" "$HOST"
ssh "$HOST"
printf "\n  ${D}disconnected${N}\n"
