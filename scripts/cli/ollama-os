#!/usr/bin/env bash
set -euo pipefail

BR_ROOT="${BR_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
AI_TOOL="${BR_ROOT}/tools/ai/br-ai.sh"

if [[ $# -eq 0 ]]; then
  exec "$AI_TOOL" chat
fi

case "$1" in
  plan)
    shift
    exec "$AI_TOOL" ops "$@"
    ;;
  run|auto|autonomous)
    shift
    exec "$AI_TOOL" autonomous "$@"
    ;;
  chat)
    shift
    exec "$AI_TOOL" chat "$@"
    ;;
  help|--help|-h)
    cat <<'EOF'
ollama-os

Usage:
  ollama-os
  ollama-os chat [model]
  ollama-os plan <objective>
  ollama-os run <objective>
  ollama-os remediate <objective>
  ollama-os history
  ollama-os last
  ollama-os export [markdown|json] [limit]
  ollama-os replay [last|id] [auto|remediate]

Examples:
  ollama-os plan "check the Pi fleet and list models"
  ollama-os run "regenerate sites and report the result"
  ollama-os remediate "purge Cloudflare cache for blackroad.io"
  ollama-os export json 10
  ollama-os replay last remediate
  ollama-os plan "show an overview of all BlackRoad orgs"
EOF
    ;;
  remediate)
    shift
    exec "$AI_TOOL" remediate "$@"
    ;;
  history)
    shift
    exec "$AI_TOOL" history "$@"
    ;;
  last)
    exec "$AI_TOOL" last
    ;;
  export)
    shift
    exec "$AI_TOOL" export "$@"
    ;;
  replay)
    shift
    exec "$AI_TOOL" replay "$@"
    ;;
  *)
    exec "$AI_TOOL" ask "$@"
    ;;
esac
